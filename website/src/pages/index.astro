---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/data/site";
---

<BaseLayout>
  <section class="mx-auto flex min-h-dvh max-w-2xl flex-col items-start justify-center gap-5 px-6">
    <p class="text-accent font-mono text-sm tracking-wide">{site.name}</p>
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">
      {site.tagline}
    </h1>
    <p class="text-text-secondary text-lg">{site.description}</p>
    <p class="border-border bg-surface text-text-secondary rounded-surface border px-3 py-1.5 text-sm">
      Website in development
    </p>
  </section>
</BaseLayout>
