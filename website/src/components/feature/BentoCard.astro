---
import StatusBadge from "./StatusBadge.astro";
import type { FeatureStatus } from "@/data/features";

interface Props {
  title: string;
  description: string;
  status: FeatureStatus;
  /** `wide` spans two columns from md up. */
  size?: "wide" | "regular";
  class?: string;
}

const {
  title,
  description,
  status,
  size = "regular",
  class: className,
} = Astro.props;
---

<article
  class:list={[
    "border-border bg-surface hover:border-border-hover flex flex-col gap-3 rounded-xl border p-6 transition-colors",
    size === "wide" && "md:col-span-2",
    className,
  ]}
>
  <div class="flex items-start justify-between gap-3">
    <h3>{title}</h3>
    <StatusBadge status={status} />
  </div>
  <p class="text-small text-text-secondary">{description}</p>
  <slot />
</article>
