---
import { statusLabel, type FeatureStatus } from "@/data/features";
import { statusBadgeClass, statusDotClass } from "./status";

interface Props {
  status: FeatureStatus;
  class?: string;
}

const { status, class: className } = Astro.props;
// Classes (and the contrast notes) live in status.ts, shared with the demos.
---

<span data-status={status} class:list={[statusBadgeClass(status), className]}>
  <span class={statusDotClass(status)} aria-hidden="true"></span>
  {statusLabel[status]}
</span>
