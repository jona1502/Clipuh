---
import { site } from "@/data/site";
import { withBase } from "@/lib/url";

interface Props {
  /** Link target; defaults to the site root. */
  href?: string;
  class?: string;
  /** Accessible name; defaults to "<name> home". */
  label?: string;
  [attr: string]: unknown;
}

const { href = withBase(), class: className, label, ...rest } = Astro.props;
---

<a
  href={href}
  class:list={[
    "text-text inline-flex min-h-11 items-center gap-2.5 rounded-md font-semibold tracking-tight",
    className,
  ]}
  aria-label={label ?? `${site.name} home`}
  {...rest}
>
  <img
    src={withBase("clipuh-logo-128.png")}
    alt=""
    width="28"
    height="28"
    class="size-7 shrink-0"
  />
  <span class="text-lead leading-none" aria-hidden="true">
    {site.name}
  </span>
</a>
