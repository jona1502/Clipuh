---
import FeatureSection from "@/components/feature/FeatureSection.astro";
import DemoFrame from "@/components/feature/DemoFrame.astro";
import MixerDemo from "@/components/interactive/MixerDemo";
import { featureIds, mixer } from "@/data/features";
---

<FeatureSection id={featureIds.mixer} copy={mixer} reverse>
  <DemoFrame
    slot="demo"
    label="Interactive demo · no audio is captured"
    minHeight="28rem"
  >
    <MixerDemo client:visible />
  </DemoFrame>
</FeatureSection>
