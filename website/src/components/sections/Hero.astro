---
import Button from "@/components/ui/Button.astro";
import Container from "@/components/ui/Container.astro";
import { sections, site } from "@/data/site";

const { download } = site;
const directUrl = download.available ? download.url : null;
const downloadHref = directUrl ?? `#${sections.download}`;
---

<section
  id={sections.hero}
  class="pb-section relative isolate overflow-hidden pt-16 md:pt-24"
>
  <div
    class="hero-bg pointer-events-none absolute inset-0 -z-10"
    aria-hidden="true"
  ></div>

  <Container>
    <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
      <h1 class="text-display text-gradient mt-6 pb-1">{site.tagline}</h1>
      <p class="text-lead text-text-secondary mt-5 max-w-2xl">
        Instantly save your favorite gaming moments, manage your audio sources,
        and turn clips into highlights, without leaving your game.
      </p>
      <div class="mt-8 flex w-full flex-col gap-3 min-[431px]:w-auto min-[431px]:flex-row">
        <Button href={downloadHref} size="lg">
          Download for {download.platform}
          {!directUrl && (
            <span class="bg-accent-foreground text-accent-hover text-caption ml-1 rounded-sm px-2 py-0.5 font-semibold">
              {download.statusLabel}
            </span>
          )}
        </Button>
        <Button href={`#${sections.tour}`} variant="secondary" size="lg">
          Take the tour
        </Button>
      </div>
    </div>
  </Container>
</section>

<style>
  .hero-bg {
    background:
      radial-gradient(
        64rem 30rem at 50% -10%,
        var(--color-glow),
        transparent 70%
      ),
      radial-gradient(
        40rem 24rem at 90% 40%,
        var(--color-glow-soft),
        transparent 70%
      );
  }
  .hero-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
    background-size: 64px 64px;
    opacity: 0.22;
    mask-image: radial-gradient(
      ellipse 70% 55% at 50% 0%,
      #000,
      transparent 75%
    );
  }
</style>
