---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  /** Real app screenshot. Without it a labelled placeholder is rendered. */
  src?: ImageMetadata;
  alt?: string;
  /** Eager-load (hero, above the fold) vs lazy. */
  eager?: boolean;
  class?: string;
}

const { src, alt = "", eager = false, class: className } = Astro.props;
---

<div
  class:list={[
    "border-border bg-background-elevated shadow-lg overflow-hidden rounded-xl border",
    className,
  ]}
>
  <!-- Title bar -->
  <div
    class="border-border bg-background-elevated flex h-9 items-center justify-between border-b pl-3 sm:h-10 sm:pl-4"
    aria-hidden="true"
  >
    <div class="text-text-secondary text-caption flex items-center gap-2">
      <span class="bg-accent block size-3 rounded-sm"></span>
      clipuh
    </div>
    <div class="text-text-muted flex h-full items-stretch">
      <span class="grid w-10 place-items-center sm:w-11">
        <svg
          viewBox="0 0 10 10"
          class="size-2.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
        >
          <path d="M0 5h10"></path>
        </svg>
      </span>
      <span class="grid w-10 place-items-center sm:w-11">
        <svg
          viewBox="0 0 10 10"
          class="size-2.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
        >
          <rect x="0.5" y="0.5" width="9" height="9"></rect>
        </svg>
      </span>
      <span class="grid w-10 place-items-center sm:w-11">
        <svg
          viewBox="0 0 10 10"
          class="size-2.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
        >
          <path d="M0 0l10 10M10 0L0 10"></path>
        </svg>
      </span>
    </div>
  </div>

  {src ? (
    <Image
      src={src}
      alt={alt}
      widths={[640, 960, 1280, 1920]}
      sizes="(min-width: 1200px) 1136px, 100vw"
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      class="block h-auto w-full"
    />
  ) : (
    <div
      class="relative flex aspect-[16/10] w-full"
      role="img"
      aria-label="clipuh app preview placeholder"
    >
      <div
        class="border-border bg-background-elevated hidden w-[18%] max-w-52 flex-col gap-3 border-r p-4 sm:flex"
        aria-hidden="true"
      >
        <span class="bg-accent-subtle block h-7 rounded-md" />
        <span class="bg-surface-raised block h-7 rounded-md" />
        <span class="bg-surface-raised block h-7 rounded-md" />
        <span class="bg-surface-raised block h-7 rounded-md" />
      </div>
      <div
        class="bg-background flex flex-1 flex-col gap-3 p-3 sm:gap-4 sm:p-5"
        aria-hidden="true"
      >
        <span class="bg-surface-raised block h-4 w-1/3 rounded-sm sm:h-5" />
        <div class="grid flex-1 grid-cols-3 gap-2 sm:gap-4">
          <span class="border-border bg-surface rounded-md border" />
          <span class="border-border bg-surface rounded-md border" />
          <span class="border-border bg-surface rounded-md border" />
          <span class="border-border bg-surface rounded-md border" />
          <span class="border-border bg-surface rounded-md border" />
          <span class="border-border bg-surface rounded-md border" />
        </div>
      </div>
      <div class="absolute inset-0 grid place-items-center">
        <p class="border-border bg-background/85 text-text-secondary text-small rounded-md border px-4 py-2 font-medium backdrop-blur-sm">
          App preview coming soon
        </p>
      </div>
    </div>
  )}
</div>
